rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Ranglista: mindenki olvashatja, mindenki csak a saját (névtelen) sorát írhatja.
    match /board/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nick','total','quiz','hangar','sim','ter','dd','at'])
        && request.resource.data.nick is string
        && request.resource.data.nick.size() >= 2 && request.resource.data.nick.size() <= 24
        && request.resource.data.total is number && request.resource.data.total >= 0 && request.resource.data.total < 100000;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
